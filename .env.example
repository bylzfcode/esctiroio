# ---------------------------------------------------------------------------
# Copie para .env.local (nunca versionado) e preencha. Vite só lê variáveis VITE_*
# e TUDO que começa com VITE_ vai para o navegador: use somente valores PÚBLICOS.
# ---------------------------------------------------------------------------

# URL do projeto Supabase (Project Settings > API). Local: http://127.0.0.1:54321
VITE_SUPABASE_URL=

# Chave PÚBLICA (anon / publishable). O que cada pessoa pode ler ou fazer é decidido
# no banco (RLS + funções) a partir do login. NUNCA use a chave service_role / secret aqui:
# o app recusa iniciar se detectar uma chave privilegiada.
VITE_SUPABASE_ANON_KEY=

# O modo demonstração (dados fictícios, sem backend) NÃO é ligado por variável.
# Use o comando explícito:  npm run dev:demo  /  npm run build:demo

# ---------------------------------------------------------------------------
# NÃO coloque aqui (nem em nenhum arquivo versionado):
#   SUPABASE_SERVICE_ROLE_KEY, senhas de banco, tokens de SMTP.
# A Edge Function recebe a chave de serviço do ambiente do próprio Supabase;
# APP_URL e ALLOWED_ORIGINS são definidos com `supabase secrets set` (veja docs/BACKEND.md).
# ---------------------------------------------------------------------------
