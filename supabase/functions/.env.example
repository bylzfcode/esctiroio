# Copie para supabase/functions/.env (ignorado pelo Git) ao rodar a pilha LOCAL.
# SÓ valores não secretos. SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY NÃO vão aqui:
# a própria plataforma as fornece ao ambiente da função.

# Para onde o link do convite leva (precisa constar em additional_redirect_urls do config.toml).
APP_URL=http://127.0.0.1:5173

# Origens do app autorizadas a chamar a função (CORS é fail-closed: origem fora da lista é bloqueada).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
